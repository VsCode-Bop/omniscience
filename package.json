{
  "name": "omniscience",
  "version": "0.1.0",
  "private": true,
  "description": "OmniScience — plateforme open source d'outils interactifs pour l'enseignement des mathématiques et de la physique-chimie (100 % côté client, hébergeable sur GitHub Pages).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "jspdf": "^4.2.1",
    "katex": "^0.18.9",
    "lz-string": "^1.5.0",
    "mathjs": "^15.2.0",
    "qrcode-generator": "^2.0.4",
    "svg2pdf.js": "^2.8.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
